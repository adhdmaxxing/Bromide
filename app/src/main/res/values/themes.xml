<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- DayNight, so the starting window and system dialogs follow the phone's dark mode like the app. -->
    <style name="Theme.Bromide" parent="android:Theme.DeviceDefault.DayNight">
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@color/fb_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
